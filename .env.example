# Copy to .env and adjust as needed. docker-compose.yml reads this file automatically.

# --- Database -----------------------------------------------------------
POSTGRES_DB=meshatlas
POSTGRES_USER=meshatlas
POSTGRES_PASSWORD=change-me
# Used by the api container to connect (host is the compose service name).
DATABASE_URL=postgresql+psycopg://meshatlas:change-me@db:5432/meshatlas

# --- API / ingestion ------------------------------------------------------
# Comma-separated list of source plugin ids to run. Only "meshtastic" ships
# today; future sources (aprs, lora_aprs, meshcore) can be added to this list
# once implemented, without changing any other config.
ENABLED_SOURCES=meshtastic

# Port the API container exposes on the host.
API_PORT=8000

# --- Meshtastic MQTT source ------------------------------------------------
MESHTASTIC_MQTT_HOST=mqtt.lucifernet.com
MESHTASTIC_MQTT_PORT=1883
MESHTASTIC_MQTT_USERNAME=
MESHTASTIC_MQTT_PASSWORD=
MESHTASTIC_MQTT_TLS=false
# Root topic to subscribe under, "#" is a wildcard for every region/channel.
MESHTASTIC_MQTT_TOPIC=msh/#
# Comma-separated base64 channel keys to try when decrypting packets, in
# addition to the well-known default channel key ("AQ==") which is always
# tried first. Add your own private channel PSKs here if you use them.
MESHTASTIC_CHANNEL_KEYS=

# --- Web frontend -----------------------------------------------------
WEB_PORT=8080
# Public base URL the browser uses to reach the API (same-origin via nginx
# proxy by default, so this is normally left as "/api").
API_BASE_URL=/api
# Any MapLibre-compatible vector style URL. Defaults to the free OpenFreeMap
# "liberty" style (OpenStreetMap data, no API key required).
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Copy to .env and adjust as needed. docker-compose.yml reads this file
# automatically. Credentials (passwords, MQTT logins) do NOT live here --
# see secrets.env.example instead, kept separate on purpose.

# --- Database -----------------------------------------------------------
POSTGRES_DB=meshatlas
POSTGRES_USER=meshatlas
# POSTGRES_PASSWORD lives in secrets.env. app/config.py builds the full
# DATABASE_URL from POSTGRES_USER/PASSWORD/DB plus POSTGRES_HOST/PORT
# (hardcoded to the "db" compose service in docker-compose.yml) -- set
# DATABASE_URL directly here instead if you need to point at an external
# Postgres that doesn't fit that shape.

# --- API / ingestion ------------------------------------------------------
# Comma-separated list of source plugin ids to run. Only "meshtastic" ships
# today; future sources (aprs, lora_aprs, meshcore) can be added to this list
# once implemented, without changing any other config.
ENABLED_SOURCES=meshtastic

# Port the API container exposes on the host.
API_PORT=8000

# --- Meshtastic MQTT source ------------------------------------------------
MESHTASTIC_MQTT_HOST=mqtt.lucifernet.com
MESHTASTIC_MQTT_PORT=1883
# MESHTASTIC_MQTT_USERNAME / _PASSWORD live in secrets.env.
MESHTASTIC_MQTT_TLS=false
# Root topic to subscribe under, "#" is a wildcard for every region/channel.
MESHTASTIC_MQTT_TOPIC=msh/#
# Comma-separated base64 channel keys to try when decrypting packets, in
# addition to the well-known default channel key ("AQ==") which is always
# tried first. Add your own private channel PSKs here if you use them.
MESHTASTIC_CHANNEL_KEYS=

# --- Web frontend -----------------------------------------------------
WEB_PORT=8080
# Public base URL the browser uses to reach the API (same-origin via nginx
# proxy by default, so this is normally left as "/api").
API_BASE_URL=/api
# Any MapLibre-compatible vector style URL. Defaults to OpenFreeMap's free
# "dark" style (no API key required); the frontend patches its water color
# at runtime for better contrast at low zoom (see web/src/mapSetup.ts).
# Note: OpenFreeMap style URLs serve the style JSON directly with no
# "/style.json" suffix -- https://tiles.openfreemap.org/styles/<name>, not
# .../styles/<name>/style.json (a 404). Other free/no-key OpenFreeMap
# styles: "liberty", "bright", "positron". CARTO's "Dark Matter" style
# (https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json) has
# better contrast out of the box with no patching needed, but its tile CDN
# isn't reachable from every network -- try it and fall back to the
# default above if the map never finishes loading.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
